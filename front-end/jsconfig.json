    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "jsx": "react-jsx",
        "baseUrl": "./src",
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "build"]
}